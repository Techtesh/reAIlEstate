# Raw key=value format: no quotes, expansion, or multiline values.
# Copy to app.env on EC2 only; chmod 600 app.env.
PGHOST=replace-with-your-rds-endpoint
PGPORT=5432
PGDATABASE=realestate
PGUSER=realestate
PGPASSWORD=replace-with-rds-secret
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/rds-bundle.pem
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=replace-with-buyer-domain.example,replace-with-builder-domain.example,replace-with-admin-domain.example,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://replace-with-buyer-domain.example,https://replace-with-builder-domain.example,https://replace-with-admin-domain.example
CORS_ALLOWED_ORIGINS=https://replace-with-buyer-domain.example,https://replace-with-builder-domain.example,https://replace-with-admin-domain.example
USE_X_FORWARDED_PROTO=true
SECURE_SSL_REDIRECT=true
ENVIRONMENT=poc
WORKSPACE_DATA_ROOT=/workspace
MEDIA_ROOT=/workspace/legacy-media
CLAMAV_ENABLED=false
LOCAL_TRUST_BUILDER_UPLOADS=false
FLOOR_PLAN_EXTRACTION_MODE=script
OTEL_ENABLED=false
INGESTION_MAX_WORKERS=1
VISION_MAX_CONCURRENT_REQUESTS=1
