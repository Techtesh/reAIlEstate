{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode buyer",
    "dev:buyer": "vite --mode buyer",
    "dev:builder": "vite --mode builder --port 5174",
    "dev:test": "vite --mode development",
    "build": "tsc -b && vite build --mode buyer",
    "build:buyer": "tsc -b && vite build --mode buyer",
    "build:builder": "tsc -b && vite build --mode builder",
    "build:services": "tsc -b && vite build --mode buyer && vite build --mode builder",
    "test": "vitest run src/buyer.test.ts",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "preview": "vite preview --mode buyer",
    "preview:buyer": "vite preview --mode buyer",
    "preview:builder": "vite preview --mode builder --port 5175",
    "preview:test": "vite preview --mode development"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.3",
    "vitest": "^5.0.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
