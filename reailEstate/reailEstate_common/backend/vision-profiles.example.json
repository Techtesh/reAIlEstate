{
  "ollama-local": {
    "label": "Local Ollama vision",
    "provider": "ollama",
    "model": "qwen2.5vl:7b",
    "base_url": "http://127.0.0.1:11434/v1",
    "response_format": "json_object"
  },
  "foundry-cloud": {
    "label": "Microsoft Foundry vision",
    "provider": "azure_foundry",
    "model": "REPLACE_WITH_VISION_DEPLOYMENT_NAME",
    "base_url": "https://YOUR-RESOURCE.openai.azure.com/openai/v1/",
    "response_format": "json_schema",
    "enabled": false
  },
  "cloud-instance": {
    "label": "Cloud OpenAI-compatible vision instance",
    "provider": "cloud_openai",
    "model": "REPLACE_WITH_SERVED_VISION_MODEL",
    "base_url": "https://YOUR-INFERENCE-HOST.example.com/v1/",
    "api_key_env": "CLOUD_VISION_API_KEY",
    "response_format": "json_object",
    "enabled": false
  }
}
